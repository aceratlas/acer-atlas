rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Clients may create only a Free profile. A browser cannot grant itself Plus.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['plan', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.plan == 'free'
        && request.resource.data.email is string;
      // A client may update email/timestamp, but cannot change the plan.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan == resource.data.plan
        && resource.data.plan == 'free'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
