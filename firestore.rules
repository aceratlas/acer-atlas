rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAcerAtlasAdmin() {
      return request.auth != null
        && request.auth.token.email == 'aceratlas.maple@outlook.com';
    }
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAcerAtlasAdmin());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['plan', 'email', 'createdAt', 'updatedAt', 'plusInterest', 'plusInterestAt'])
        && request.resource.data.plan == 'free'
        && request.resource.data.email is string
        && (!('plusInterest' in request.resource.data) || request.resource.data.plusInterest == true)
        && (!('plusInterestAt' in request.resource.data) || request.resource.data.plusInterestAt is timestamp);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan == resource.data.plan
        && resource.data.plan == 'free'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt', 'plusInterest', 'plusInterestAt'])
        && (!('plusInterest' in request.resource.data) || request.resource.data.plusInterest is bool);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    function ownsAtlasAccount(userId) { return request.auth != null && request.auth.uid == userId; }
    match /users/{userId}/atlasPlants/{plantId} { allow read, create, update, delete: if ownsAtlasAccount(userId); }
    match /users/{userId}/atlasWishlist/{itemId} { allow read, create, update, delete: if ownsAtlasAccount(userId); }
    match /users/{userId}/atlasSeedlings/{seedlingId} { allow read, create, update, delete: if ownsAtlasAccount(userId); }
    match /users/{userId}/atlasMetadata/{metadataId} { allow read, create, update, delete: if ownsAtlasAccount(userId); }
    match /communityPhotos/{photoId} {
      allow read: if verifiedUser();
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['ownerUid','ownerLabel','cultivar','season','caption','storagePath','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerLabel is string
        && request.resource.data.ownerLabel.size() <= 80
        && request.resource.data.cultivar is string
        && request.resource.data.cultivar.size() > 0
        && request.resource.data.cultivar.size() <= 120
        && request.resource.data.season in ['spring','summer','autumn','winter','unknown']
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 240
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('community/' + request.auth.uid + '/[A-Za-z0-9_-]+');
      allow update: if false;
      allow delete: if verifiedUser() && resource.data.ownerUid == request.auth.uid;
      match /likes/{userId} {
        allow read: if verifiedUser();
        allow create: if verifiedUser() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if verifiedUser() && request.auth.uid == userId;
      }
    }
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.to == 'aceratlas.maple@outlook.com'
        && request.resource.data.type == 'plus-interest'
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject == 'Acer Atlas Plus: nieuwe interesse'
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() < 2000;
      allow read, update, delete: if isAcerAtlasAdmin();
    }
  }
}