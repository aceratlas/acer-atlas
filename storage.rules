rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /devdatabase/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'aceratlas.maple@outlook.com'
        && request.auth.token.email_verified == true;
    }
    // Community copies are visible only to authenticated, verified Acer Atlas users.
    // Each user can upload or remove only files in their own folder.
    match /community/{userId}/{photoId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }
  }
}